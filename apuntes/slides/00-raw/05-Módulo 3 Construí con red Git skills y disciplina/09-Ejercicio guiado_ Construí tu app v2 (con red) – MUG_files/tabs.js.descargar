/**
 * Dilux One Tabs - Frontend JavaScript
 */

class DiluxMagicTabs {
    constructor(element) {
        this.element = element;
        this.groupId = element.dataset.groupId;
        this.componentType = element.dataset.componentType || 'tabs';
        this.orientation = element.dataset.orientation || 'horizontal';
        this.animation = element.dataset.animation || 'fade';
        this.lazyLoading = element.dataset.lazyLoading === 'true';
        this.deepLinking = element.dataset.deepLinking === 'true';
        this.mobileBreakpoint = 768;

        // Check if this is an accordion component
        this.isAccordion = this.componentType === 'accordion';

        if (this.isAccordion) {
            // Accordion elements
            this.accordionBehavior = element.dataset.accordionBehavior || 'single';
            this.accordionItems = element.querySelectorAll('.dilux-accordion-item');
            this.accordionHeaders = element.querySelectorAll('.dilux-accordion-header');
            this.accordionPanels = element.querySelectorAll('.dilux-accordion-panel');
            this.loadedTabs = new Set(); // Track loaded content

            // Find initially open panels
            this.accordionPanels.forEach((panel, index) => {
                if (panel.classList.contains('active')) {
                    this.loadedTabs.add(index);
                }
            });
        } else {
            // Regular tabs elements
            this.tabButtons = element.querySelectorAll('.dilux-tab-button');
            this.tabPanels = element.querySelectorAll('.dilux-tab-panel');
            this.activeIndex = 0;
            this.loadedTabs = new Set([0]); // First tab is already loaded
        }

        this.init();
    }

    init() {
        if (this.isAccordion) {
            // Initialize accordion
            this.initAccordion();
        } else {
            // Initialize regular tabs
            this.initRegularTabs();
        }

        // Handle deep linking
        if (this.deepLinking) {
            this.handleDeepLinking();
            window.addEventListener('hashchange', () => this.handleDeepLinking());
        }
    }

    initRegularTabs() {
        // Attach click handlers to tab buttons
        this.tabButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
                this.switchTab(index);
            });
        });

        // Transform to accordion on mobile
        if (window.innerWidth <= this.mobileBreakpoint) {
            this.transformToAccordion();
        }

        // Re-check on resize (with debounce)
        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                if (window.innerWidth <= this.mobileBreakpoint && !this.element.classList.contains('dilux-magic-tabs-accordion')) {
                    this.transformToAccordion();
                } else if (window.innerWidth > this.mobileBreakpoint && this.element.classList.contains('dilux-magic-tabs-accordion')) {
                    this.restoreFromAccordion();
                }
            }, 250);
        });
    }

    initAccordion() {
        // Attach click handlers to accordion headers
        this.accordionHeaders.forEach((header, index) => {
            header.addEventListener('click', () => {
                this.toggleAccordionItem(index);
            });
        });
    }

    toggleAccordionItem(index) {
        const item = this.accordionItems[index];
        const header = this.accordionHeaders[index];
        const panel = this.accordionPanels[index];
        const isActive = item.classList.contains('active');

        if (isActive) {
            // Close this item
            item.classList.remove('active');
            header.setAttribute('aria-expanded', 'false');
            panel.classList.remove('active');
        } else {
            // If behavior is 'single', close all other items first
            if (this.accordionBehavior === 'single') {
                this.accordionItems.forEach((otherItem, i) => {
                    if (i !== index) {
                        otherItem.classList.remove('active');
                        this.accordionHeaders[i].setAttribute('aria-expanded', 'false');
                        this.accordionPanels[i].classList.remove('active');
                    }
                });
            }

            // Open this item
            item.classList.add('active');
            header.setAttribute('aria-expanded', 'true');
            panel.classList.add('active');

            // Load content if lazy loading
            if (this.lazyLoading && !this.loadedTabs.has(index)) {
                this.loadAccordionContent(panel, index);
            }

            // Update URL hash if deep linking enabled
            if (this.deepLinking) {
                const itemElement = this.accordionItems[index];
                const slug = itemElement.dataset.tabSlug;
                if (slug) {
                    history.pushState(null, null, '#tab-' + slug);
                }
            }
        }
    }

    loadAccordionContent(panel, index) {
        const itemElement = this.accordionItems[index];
        const tabId = itemElement.dataset.tabId;

        if (!tabId || !panel.dataset.lazy) {
            return;
        }

        const contentWrapper = panel.querySelector('.dilux-accordion-content');

        // Show loading state
        contentWrapper.innerHTML = '<div class="dilux-accordion-loading"><p>Loading...</p></div>';

        // AJAX request
        fetch(diluxMagicTabsData.ajaxUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                action: 'dilux_magic_tabs_load_content',
                nonce: diluxMagicTabsData.nonce,
                tab_id: tabId,
            }),
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                contentWrapper.innerHTML = data.data.content;
                panel.removeAttribute('data-lazy');
                this.loadedTabs.add(index);
            } else {
                contentWrapper.innerHTML = '<div class="dilux-accordion-error"><p>Error loading content.</p></div>';
            }
        })
        .catch(error => {
            contentWrapper.innerHTML = '<div class="dilux-accordion-error"><p>Error loading content.</p></div>';
        });
    }

    switchTab(index) {
        if (index === this.activeIndex) {
            return; // Already active
        }

        const fromPanel = this.tabPanels[this.activeIndex];
        const toPanel = this.tabPanels[index];
        const toButton = this.tabButtons[index];

        // Deactivate current tab
        this.tabButtons[this.activeIndex].classList.remove('active');
        this.tabButtons[this.activeIndex].setAttribute('aria-selected', 'false');
        fromPanel.classList.remove('active');

        // Update active index
        this.activeIndex = index;

        // Lazy load if needed
        if (this.lazyLoading && !this.loadedTabs.has(index)) {
            this.loadTabContent(toPanel, () => {
                this.activateTab(toButton, toPanel);
            });
        } else {
            this.activateTab(toButton, toPanel);
        }

        // Update URL hash if deep linking enabled
        if (this.deepLinking) {
            const slug = toButton.dataset.tabSlug;
            if (slug) {
                history.pushState(null, null, '#tab-' + slug);
            }
        }
    }

    activateTab(button, panel) {
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');
        panel.classList.add('active');

        // Scroll to tabs container (smooth scroll)
        if (window.innerWidth <= this.mobileBreakpoint) {
            this.element.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    loadTabContent(panel, callback) {
        const tabId = panel.dataset.tabId;

        if (!tabId || !panel.dataset.lazy) {
            callback();
            return;
        }

        // Show loading state
        panel.innerHTML = '<div class="dilux-tab-loading"><p>Loading...</p></div>';

        // AJAX request
        fetch(diluxMagicTabsData.ajaxUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                action: 'dilux_magic_tabs_load_content',
                nonce: diluxMagicTabsData.nonce,
                tab_id: tabId,
            }),
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                panel.innerHTML = data.data.content;
                panel.removeAttribute('data-lazy');
                this.loadedTabs.add(parseInt(panel.dataset.tabIndex));
                callback();
            } else {
                panel.innerHTML = '<div class="dilux-tab-error"><p>Error loading content.</p></div>';
            }
        })
        .catch(error => {
            panel.innerHTML = '<div class="dilux-tab-error"><p>Error loading content.</p></div>';
        });
    }

    handleDeepLinking() {
        const hash = window.location.hash;

        if (!hash || !hash.startsWith('#tab-')) {
            return;
        }

        const slug = hash.replace('#tab-', '');

        if (this.isAccordionVertical) {
            // Find accordion header with matching slug
            this.accordionHeaders.forEach((header, index) => {
                if (header.dataset.tabSlug === slug) {
                    this.toggleAccordionItem(index);
                }
            });
        } else {
            // Find tab with matching slug
            this.tabButtons.forEach((button, index) => {
                if (button.dataset.tabSlug === slug) {
                    this.switchTab(index);
                }
            });
        }
    }

    transformToAccordion() {
        this.element.classList.add('dilux-magic-tabs-accordion');

        // Create accordion structure
        const accordion = document.createElement('div');
        accordion.className = 'dilux-accordion';

        this.tabButtons.forEach((button, index) => {
            const panel = this.tabPanels[index];

            // Create accordion item
            const item = document.createElement('div');
            item.className = 'dilux-accordion-item';

            // Create accordion header
            const header = document.createElement('button');
            header.className = 'dilux-accordion-header' + (index === this.activeIndex ? ' active' : '');
            header.innerHTML = button.innerHTML + '<span class="dilux-accordion-arrow">▼</span>';
            header.setAttribute('aria-expanded', index === this.activeIndex ? 'true' : 'false');

            // Create accordion content
            const content = document.createElement('div');
            content.className = 'dilux-accordion-content' + (index === this.activeIndex ? ' active' : '');

            const contentInner = document.createElement('div');
            contentInner.className = 'dilux-accordion-content-inner';
            contentInner.innerHTML = panel.innerHTML;

            content.appendChild(contentInner);

            // Click handler
            header.addEventListener('click', () => {
                // Close all other items
                accordion.querySelectorAll('.dilux-accordion-header').forEach(h => {
                    if (h !== header) {
                        h.classList.remove('active');
                        h.setAttribute('aria-expanded', 'false');
                        h.nextElementSibling.classList.remove('active');
                    }
                });

                // Toggle this item
                const isActive = header.classList.contains('active');
                if (isActive) {
                    header.classList.remove('active');
                    header.setAttribute('aria-expanded', 'false');
                    content.classList.remove('active');
                } else {
                    header.classList.add('active');
                    header.setAttribute('aria-expanded', 'true');
                    content.classList.add('active');

                    // Load content if lazy loading
                    if (this.lazyLoading && !this.loadedTabs.has(index)) {
                        this.loadTabContent(panel, () => {
                            contentInner.innerHTML = panel.innerHTML;
                            this.loadedTabs.add(index);
                        });
                    }
                }
            });

            item.appendChild(header);
            item.appendChild(content);
            accordion.appendChild(item);
        });

        this.element.appendChild(accordion);
    }

    restoreFromAccordion() {
        this.element.classList.remove('dilux-magic-tabs-accordion');

        // Remove accordion structure
        const accordion = this.element.querySelector('.dilux-accordion');
        if (accordion) {
            accordion.remove();
        }
    }
}

// Initialize all tab groups and accordions on page load
document.addEventListener('DOMContentLoaded', () => {
    // Initialize tabs
    document.querySelectorAll('.dilux-magic-tabs-container').forEach(element => {
        new DiluxMagicTabs(element);
    });

    // Initialize accordions
    document.querySelectorAll('.dilux-magic-accordion-container').forEach(element => {
        new DiluxMagicTabs(element);
    });
});
