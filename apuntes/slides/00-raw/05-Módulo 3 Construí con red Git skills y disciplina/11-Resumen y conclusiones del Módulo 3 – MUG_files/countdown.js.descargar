/**
 * Dilux One Countdown - Frontend JavaScript
 * Handles countdown timer logic and SVG progress animations
 */

(function() {
    'use strict';

    /**
     * Initialize all countdowns on page
     */
    function initCountdowns() {
        const countdowns = document.querySelectorAll('.dilux-countdown:not(.dilux-countdown-expired-state)');

        countdowns.forEach(function(countdown) {
            const countdownObj = new DiluxCountdown(countdown);
            countdownObj.start();
        });
    }

    /**
     * Countdown Timer Class
     */
    class DiluxCountdown {
        constructor(element) {
            this.element = element;
            this.expiryTimestamp = parseInt(element.dataset.expiry);
            this.showMessage = element.dataset.showMessage === '1';
            this.blurOnExpiry = element.dataset.blur === '1';
            this.message = element.dataset.message || 'This countdown has expired';
            this.animation = element.dataset.animation || 'none';
            this.celebrationType = element.dataset.celebrationType || 'classic';
            this.units = element.querySelectorAll('.dilux-countdown-unit');
            this.interval = null;
        }

        /**
         * Start the countdown
         */
        start() {
            // Initial update
            this.update();

            // Update every second
            this.interval = setInterval(() => {
                this.update();
            }, 1000);
        }

        /**
         * Stop the countdown
         */
        stop() {
            if (this.interval) {
                clearInterval(this.interval);
                this.interval = null;
            }
        }

        /**
         * Update countdown display
         */
        update() {
            const now = Math.floor(Date.now() / 1000);
            const remaining = this.expiryTimestamp - now;

            if (remaining <= 0) {
                this.handleExpiry();
                return;
            }

            const time = this.calculateTime(remaining);
            this.updateDisplay(time);
        }

        /**
         * Calculate time units from remaining seconds
         */
        calculateTime(seconds) {
            return {
                days: Math.floor(seconds / 86400),
                hours: Math.floor((seconds % 86400) / 3600),
                minutes: Math.floor((seconds % 3600) / 60),
                seconds: seconds % 60
            };
        }

        /**
         * Update display for each unit
         */
        updateDisplay(time) {
            this.units.forEach((unit) => {
                const unitType = unit.dataset.unit;
                const value = time[unitType];
                const max = parseInt(unit.dataset.max);

                // Update number
                const numberEl = unit.querySelector('.dilux-countdown-number');
                if (numberEl) {
                    numberEl.textContent = value;
                }

                // Update progress circle
                this.updateProgress(unit, value, max);
            });
        }

        /**
         * Update SVG circle progress
         */
        updateProgress(unit, currentValue, maxValue) {
            const circle = unit.querySelector('.dilux-countdown-progress');
            if (!circle) return;

            const radius = parseFloat(circle.getAttribute('r'));
            const circumference = 2 * Math.PI * radius;

            // Calculate progress (0 to 1)
            // For countdown, we want progress to decrease as value decreases
            const progress = currentValue / maxValue;

            // Calculate stroke-dashoffset
            // When progress = 1 (full), offset = 0 (full circle)
            // When progress = 0 (empty), offset = circumference (empty circle)
            const offset = circumference * (1 - progress);

            circle.style.strokeDashoffset = offset;
        }

        /**
         * Handle countdown expiry
         * Supports: show_expiry_message, blur_on_expiry, expiry_animation (all independent)
         */
        handleExpiry() {
            this.stop();

            // Set all values to zero
            const time = { days: 0, hours: 0, minutes: 0, seconds: 0 };
            this.updateDisplay(time);

            // Set all progress circles to empty
            this.units.forEach((unit) => {
                this.updateProgress(unit, 0, parseInt(unit.dataset.max));
            });

            // Clone the current countdown element
            const countdownClone = this.element.cloneNode(true);

            // Build wrapper with appropriate classes
            const wrapper = document.createElement('div');
            wrapper.className = 'dilux-countdown-expired-wrapper';
            wrapper.dataset.countdownId = this.element.dataset.countdownId;
            wrapper.dataset.animation = this.animation;
            wrapper.dataset.celebrationType = this.celebrationType;
            wrapper.dataset.blur = this.blurOnExpiry ? '1' : '0';

            // Add animation class if specified
            if (this.animation && this.animation !== 'none') {
                wrapper.classList.add('dilux-animation-' + this.animation);
            }

            // Add blur class if specified
            if (this.blurOnExpiry) {
                wrapper.classList.add('dilux-expired-blur');
            }

            // Case 1: Show message (with or without blur and animation)
            if (this.showMessage) {
                // Create background container with countdown
                const background = document.createElement('div');
                background.className = 'dilux-countdown-expired-background';
                background.appendChild(countdownClone);

                // Create message overlay
                const messageDiv = document.createElement('div');
                messageDiv.className = 'dilux-countdown-expired-message';
                messageDiv.textContent = this.message;

                // Assemble the structure
                wrapper.appendChild(background);
                wrapper.appendChild(messageDiv);

                // Add animation elements
                this.addAnimationElements(wrapper, this.animation);

                // Replace the countdown element with the wrapper
                this.element.parentNode.replaceChild(wrapper, this.element);
            }
            // Case 2: No message, just countdown with optional blur and animation
            else {
                // Wrap countdown without message
                wrapper.appendChild(countdownClone);

                // Add animation elements
                this.addAnimationElements(wrapper, this.animation);

                // Replace the countdown element with the wrapper
                this.element.parentNode.replaceChild(wrapper, this.element);
            }
        }

        /**
         * Add animation elements based on animation type
         */
        addAnimationElements(wrapper, animationType) {
            if (!animationType || animationType === 'none') {
                return;
            }

            switch (animationType) {
                case 'celebration':
                    this.createConfetti(wrapper);
                    break;
                case 'warning':
                    this.createWarningIcons(wrapper);
                    break;
                case 'elegant':
                    this.createElegantOverlay(wrapper);
                    break;
            }
        }

        /**
         * Create confetti animation using canvas-confetti library
         */
        createConfetti(wrapper) {
            // Check if canvas-confetti is loaded
            if (typeof confetti === 'undefined') {
                return;
            }

            const colors = ['#ff6b6b', '#4ecdc4', '#45b7d1', '#f9ca24', '#6c5ce7', '#fd79a8'];

            switch (this.celebrationType) {
                case 'classic':
                    // Classic explosion from center
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: colors
                    });
                    break;

                case 'cannons':
                    // Side cannons shooting confetti
                    const duration = 2 * 1000;
                    const end = Date.now() + duration;

                    (function frame() {
                        confetti({
                            particleCount: 2,
                            angle: 60,
                            spread: 55,
                            origin: { x: 0, y: 0.6 },
                            colors: colors
                        });
                        confetti({
                            particleCount: 2,
                            angle: 120,
                            spread: 55,
                            origin: { x: 1, y: 0.6 },
                            colors: colors
                        });

                        if (Date.now() < end) {
                            requestAnimationFrame(frame);
                        }
                    }());
                    break;

                case 'rain':
                    // Confetti falling from top for 3 seconds
                    const rainDuration = 3 * 1000;
                    const rainEnd = Date.now() + rainDuration;

                    (function rainFrame() {
                        confetti({
                            particleCount: 3,
                            angle: 90,
                            spread: 45,
                            origin: { x: Math.random(), y: 0 },
                            colors: colors,
                            gravity: 1.2,
                            scalar: 0.8
                        });

                        if (Date.now() < rainEnd) {
                            requestAnimationFrame(rainFrame);
                        }
                    }());
                    break;

                case 'fireworks':
                    // Multiple coordinated bursts
                    const fireworksDuration = 3 * 1000;
                    const fireworksEnd = Date.now() + fireworksDuration;
                    const fireworksInterval = 400;

                    (function fireworksFrame() {
                        confetti({
                            particleCount: 50,
                            spread: 100,
                            origin: {
                                x: Math.random() * 0.6 + 0.2,
                                y: Math.random() * 0.4 + 0.3
                            },
                            colors: colors
                        });

                        if (Date.now() < fireworksEnd) {
                            setTimeout(fireworksFrame, fireworksInterval);
                        }
                    }());
                    break;

                case 'stars':
                    // Star-shaped confetti explosion
                    const defaults = {
                        spread: 360,
                        ticks: 50,
                        gravity: 0,
                        decay: 0.94,
                        startVelocity: 30,
                        colors: colors
                    };

                    function shoot() {
                        confetti({
                            ...defaults,
                            particleCount: 40,
                            scalar: 1.2,
                            shapes: ['star']
                        });

                        confetti({
                            ...defaults,
                            particleCount: 10,
                            scalar: 0.75,
                            shapes: ['circle']
                        });
                    }

                    setTimeout(shoot, 0);
                    setTimeout(shoot, 100);
                    setTimeout(shoot, 200);
                    break;

                default:
                    // Fallback to classic
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: colors
                    });
            }
        }

        /**
         * Create warning icons animation
         */
        createWarningIcons(wrapper) {
            const positions = [
                { top: '10%', left: '10%' },
                { top: '10%', right: '10%' },
                { bottom: '10%', left: '10%' },
                { bottom: '10%', right: '10%' }
            ];

            positions.forEach((pos, index) => {
                const icon = document.createElement('div');
                icon.className = 'dilux-warning-icon';
                icon.textContent = '⚠';
                Object.assign(icon.style, pos);
                icon.style.animationDelay = (index * 0.2) + 's';
                wrapper.appendChild(icon);
            });
        }

        /**
         * Create elegant overlay animation
         */
        createElegantOverlay(wrapper) {
            const overlay = document.createElement('div');
            overlay.className = 'dilux-elegant-overlay';
            wrapper.appendChild(overlay);
        }

        /**
         * Escape HTML to prevent XSS
         */
        escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCountdowns);
    } else {
        initCountdowns();
    }

    // Expose for debugging
    window.DiluxCountdown = DiluxCountdown;

})();
