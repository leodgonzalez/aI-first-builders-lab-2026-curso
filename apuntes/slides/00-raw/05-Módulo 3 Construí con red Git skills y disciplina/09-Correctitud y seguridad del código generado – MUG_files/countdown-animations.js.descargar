/**
 * Dilux One Countdown - Animation Initializer
 * Handles animation elements for expired countdowns that are already loaded on page
 */

(function() {
    'use strict';

    /**
     * Initialize animations on already-expired countdowns
     */
    function initExpiredAnimations() {
        const expiredWrappers = document.querySelectorAll('.dilux-countdown-expired-wrapper');

        expiredWrappers.forEach(function(wrapper) {
            const animation = wrapper.dataset.animation;
            if (!animation || animation === 'none') {
                return;
            }

            // Add animation elements
            switch (animation) {
                case 'celebration':
                    const celebrationType = wrapper.dataset.celebrationType || 'classic';
                    createConfetti(wrapper, celebrationType);
                    break;
                case 'warning':
                    createWarningIcons(wrapper);
                    break;
                case 'elegant':
                    createElegantOverlay(wrapper);
                    break;
            }
        });
    }

    /**
     * Create confetti animation using canvas-confetti library
     */
    function createConfetti(wrapper, celebrationType) {
        // Check if canvas-confetti is loaded
        if (typeof confetti === 'undefined') {
            return;
        }

        const colors = ['#ff6b6b', '#4ecdc4', '#45b7d1', '#f9ca24', '#6c5ce7', '#fd79a8'];

        switch (celebrationType) {
            case 'classic':
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: colors
                });
                break;

            case 'cannons':
                const duration = 2 * 1000;
                const end = Date.now() + duration;

                (function frame() {
                    confetti({
                        particleCount: 2,
                        angle: 60,
                        spread: 55,
                        origin: { x: 0, y: 0.6 },
                        colors: colors
                    });
                    confetti({
                        particleCount: 2,
                        angle: 120,
                        spread: 55,
                        origin: { x: 1, y: 0.6 },
                        colors: colors
                    });

                    if (Date.now() < end) {
                        requestAnimationFrame(frame);
                    }
                }());
                break;

            case 'rain':
                const rainDuration = 3 * 1000;
                const rainEnd = Date.now() + rainDuration;

                (function rainFrame() {
                    confetti({
                        particleCount: 3,
                        angle: 90,
                        spread: 45,
                        origin: { x: Math.random(), y: 0 },
                        colors: colors,
                        gravity: 1.2,
                        scalar: 0.8
                    });

                    if (Date.now() < rainEnd) {
                        requestAnimationFrame(rainFrame);
                    }
                }());
                break;

            case 'fireworks':
                const fireworksDuration = 3 * 1000;
                const fireworksEnd = Date.now() + fireworksDuration;
                const fireworksInterval = 400;

                (function fireworksFrame() {
                    confetti({
                        particleCount: 50,
                        spread: 100,
                        origin: {
                            x: Math.random() * 0.6 + 0.2,
                            y: Math.random() * 0.4 + 0.3
                        },
                        colors: colors
                    });

                    if (Date.now() < fireworksEnd) {
                        setTimeout(fireworksFrame, fireworksInterval);
                    }
                }());
                break;

            case 'stars':
                const defaults = {
                    spread: 360,
                    ticks: 50,
                    gravity: 0,
                    decay: 0.94,
                    startVelocity: 30,
                    colors: colors
                };

                function shoot() {
                    confetti({
                        ...defaults,
                        particleCount: 40,
                        scalar: 1.2,
                        shapes: ['star']
                    });

                    confetti({
                        ...defaults,
                        particleCount: 10,
                        scalar: 0.75,
                        shapes: ['circle']
                    });
                }

                setTimeout(shoot, 0);
                setTimeout(shoot, 100);
                setTimeout(shoot, 200);
                break;

            default:
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: colors
                });
        }
    }

    /**
     * Create warning icons animation
     */
    function createWarningIcons(wrapper) {
        const positions = [
            { top: '10%', left: '10%' },
            { top: '10%', right: '10%' },
            { bottom: '10%', left: '10%' },
            { bottom: '10%', right: '10%' }
        ];

        positions.forEach(function(pos, index) {
            const icon = document.createElement('div');
            icon.className = 'dilux-warning-icon';
            icon.textContent = '⚠';
            Object.assign(icon.style, pos);
            icon.style.animationDelay = (index * 0.2) + 's';
            wrapper.appendChild(icon);
        });
    }

    /**
     * Create elegant overlay animation
     */
    function createElegantOverlay(wrapper) {
        const overlay = document.createElement('div');
        overlay.className = 'dilux-elegant-overlay';
        wrapper.appendChild(overlay);
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initExpiredAnimations);
    } else {
        initExpiredAnimations();
    }

})();
